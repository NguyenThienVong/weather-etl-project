# Copy this file to .env and fill in the values
# cp .env.example .env

# Airflow
AIRFLOW_UID=50000
AIRFLOW_IMAGE_NAME=apache/airflow:3.1.7

# PostgreSQL
POSTGRES_USER=airflow
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=airflow

# Redis
REDIS_PASSWORD=CHANGE_ME_redis_password

# Airflow Admin
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=CHANGE_ME_admin_password

# Fernet key for encrypting connections/passwords
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=CHANGE_ME_generate_fernet_key

# Additional pip requirements (leave empty for production, build custom image instead)
_PIP_ADDITIONAL_REQUIREMENTS=
